# Media Gateway
MEDIA_HTTP_ADDR=:8091
LOG_LEVEL=info

# Asterisk ARI (see infra/asterisk)
ARI_BASE_URL=http://127.0.0.1:8088/ari
ARI_USERNAME=media
ARI_PASSWORD=change-me-ari
ARI_APP=sirena-media

# RTP: Media listens here; Asterisk sends to RTP_PUBLIC_HOST:RTP_PORT
RTP_LISTEN_ADDR=0.0.0.0
RTP_PORT=18000
RTP_PORT_END=18099
# From Asterisk container to Media on host: host.docker.internal
# From Asterisk to Media in compose network: media
RTP_PUBLIC_HOST=host.docker.internal

# Optional: Core base URL (events are logged until Core ingest exists)
CORE_BASE_URL=

DEFAULT_SIP_DESTINATION=PJSIP/1001

# Explicit diagnostic fallback; AI mode uses the existing voice session from Core.
MEDIA_MODE=echo
AI_BASE_URL=ws://127.0.0.1:8090
# Set CORE_BASE_URL=http://127.0.0.1:8080 to deliver to /internal/v1/media/events.
