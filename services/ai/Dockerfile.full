FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# libvosk.so слинкована с libatomic, а в slim-образе её нет. Без этой строки
# образ поднимается и отвечает на /health, но распознавание молча мертво:
# speechAvailable отдаёт false, речь превращается в ошибку speech.unavailable.
# Проверено на живой речи, других недостающих библиотек нет.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY services/ai/ /app/services/ai/
COPY contracts/ /app/contracts/
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      -r /app/services/ai/requirements.full.lock && \
    python -m pip install --no-cache-dir --disable-pip-version-check \
      --no-deps /app/services/ai

EXPOSE 8090
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "/app/services/ai", "--host", "0.0.0.0", "--port", "8090"]
