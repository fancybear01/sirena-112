FROM python:3.12-slim-bookworm

WORKDIR /app
COPY services/ai/ /app/services/ai/
COPY contracts/ /app/contracts/
RUN python -m pip install --no-cache-dir --disable-pip-version-check /app/services/ai

EXPOSE 8090
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "/app/services/ai", "--host", "0.0.0.0", "--port", "8090"]

