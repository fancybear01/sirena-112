{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirena112.local/schemas/scenario.schema.json",
  "title": "Sirena-112 training scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "category",
    "difficulty",
    "profile",
    "groundTruth",
    "rubric"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["FIRE", "ACCIDENT", "MEDICAL", "UTILITY", "GAS", "OTHER"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["BASIC", "INTERMEDIATE", "ADVANCED"]
    },
    "profile": { "type": "string", "minLength": 1 },
    "timeLimitSeconds": { "type": "integer", "minimum": 1, "default": 30 },
    "groundTruth": {
      "type": "object",
      "additionalProperties": true,
      "required": ["incidentType", "requiredServices"],
      "properties": {
        "incidentType": { "type": "string" },
        "address": { "type": ["string", "null"] },
        "requiredServices": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "facts": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persona": { "type": "string" },
        "panic": { "type": "number", "minimum": 0, "maximum": 1 },
        "trust": { "type": "number", "minimum": 0, "maximum": 1 },
        "patience": { "type": "number", "minimum": 0, "maximum": 1 },
        "voice": { "type": "string" },
        "background": { "type": "string" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "description", "weight"],
            "properties": {
              "code": { "type": "string" },
              "description": { "type": "string" },
              "weight": { "type": "number", "minimum": 0 },
              "critical": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
