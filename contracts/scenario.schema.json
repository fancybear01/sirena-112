{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirena112.local/schemas/scenario.schema.json",
  "title": "Sirena-112 training scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "category",
    "difficulty",
    "profile",
    "groundTruth",
    "rubric"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "description": "Группа происшествий по классификатору ГБУ «Система 112». Значения соответствуют 23 группам классификатора один к одному; преподаватель выбирает по ним тему занятия.",
      "enum": [
        "FIRE",
        "ACCIDENT",
        "EXPLOSION",
        "EXPLOSION_THREAT",
        "COLLAPSE",
        "COLLAPSE_THREAT",
        "NATURAL_HAZARD",
        "ENVIRONMENT",
        "HYDRAULIC_FACILITY",
        "INDUSTRIAL_ACCIDENT",
        "HAZMAT_THREAT",
        "TRANSPORT_FACILITY",
        "GAS",
        "UTILITY",
        "PUBLIC_ORDER",
        "ROAD_CONDITION",
        "PERSON_AT_RISK",
        "CHILD_AT_RISK",
        "DEATH",
        "SOCIAL_AID",
        "ANIMAL",
        "MEDICAL",
        "OTHER"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": ["BASIC", "INTERMEDIATE", "ADVANCED"]
    },
    "profile": { "type": "string", "minLength": 1 },
    "timeLimitSeconds": { "type": "integer", "minimum": 1, "default": 30 },
    "groundTruth": {
      "type": "object",
      "additionalProperties": true,
      "required": ["incidentType", "requiredServices"],
      "properties": {
        "incidentType": {
          "type": "string",
          "description": "Итоговый тип происшествия. Вычисляется из комбинации признаков по классификатору, а не задаётся произвольно."
        },
        "ekpCode": {
          "type": "string",
          "pattern": "^[0-9]{6,9}$",
          "description": "Код комбинации признаков в классификаторе происшествий."
        },
        "signs": {
          "type": "object",
          "description": "Формализованные признаки происшествия, которые оператор выбирает в опросной карте АРМ-112. Именно их выбор и оценивается, тип происшествия из них следует.",
          "additionalProperties": false,
          "required": ["level1"],
          "properties": {
            "level1": { "type": "string" },
            "level2": { "type": ["string", "null"] },
            "level3": { "type": ["string", "null"] },
            "additional": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true,
              "description": "Дополнительные признаки, не влияющие на итоговый тип."
            }
          }
        },
        "address": { "type": ["string", "null"] },
        "requiredServices": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Список оповещения. Вычисляется из итогового типа происшествия по классификатору."
        },
        "facts": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persona": { "type": "string" },
        "panic": { "type": "number", "minimum": 0, "maximum": 1 },
        "trust": { "type": "number", "minimum": 0, "maximum": 1 },
        "patience": { "type": "number", "minimum": 0, "maximum": 1 },
        "voice": { "type": "string" },
        "background": { "type": "string" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "description", "weight"],
            "properties": {
              "code": { "type": "string" },
              "description": { "type": "string" },
              "weight": { "type": "number", "minimum": 0 },
              "critical": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
