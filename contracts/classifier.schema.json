{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirena-112.local/contracts/classifier.schema.json",
  "title": "Normalized source classifier catalog 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classifierVersion", "source", "services", "sections", "columns", "questions", "signs", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "classifierVersion": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "sha256", "date", "sheet"],
      "properties": {"fileName": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "date": {"type": "string", "format": "date"}, "sheet": {"type": "string"}}
    },
    "services": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/service"}},
    "sections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "sourceRow", "routingNotes"], "properties": {"label": {"type": "string"}, "sourceRow": {"type": "integer"}, "routingNotes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["column", "rawValue"], "properties": {"column": {"type": "string"}, "rawValue": {"type": "string"}}}}}}},
    "columns": {"type": "array", "minItems": 76, "maxItems": 76, "items": {"$ref": "#/$defs/column"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "signs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sign"}},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "service": {
      "type": "object", "additionalProperties": false, "required": ["id", "displayName"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "displayName": {"type": "string", "minLength": 1}}
    },
    "column": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceColumn", "serviceId", "sourceHeaders", "condition", "requiresReview"],
      "properties": {
        "sourceColumn": {"type": "string", "pattern": "^[A-Z]{1,2}$"},
        "serviceId": {"type": "string"},
        "sourceHeaders": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": ["string", "null"]}},
        "requiresReview": {"type": "boolean"},
        "condition": {
          "type": "object", "additionalProperties": false, "required": ["all"],
          "properties": {"all": {"type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["questionId", "equals"],
            "properties": {"questionId": {"type": "string"}, "equals": {"type": ["string", "boolean"]}}
          }}}
        }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "inputType", "options", "requiresReview"],
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string", "minLength": 1},
        "inputType": {"enum": ["SINGLE_SELECT", "TEXT"]}, "requiresReview": {"type": "boolean"},
        "options": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "value": {"type": "boolean"}}
        }}
      }
    },
    "sign": {
      "type": "object", "additionalProperties": false, "required": ["id", "level", "label", "parentId"],
      "properties": {"id": {"type": "string"}, "level": {"enum": [1, 2, 3]}, "label": {"type": "string", "minLength": 1}, "parentId": {"$ref": "#/$defs/nullableText"}}
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "column", "action", "destinationIncidentType", "rawValue", "requiresReview"],
      "properties": {
        "id": {"type": "string"}, "column": {"type": "string"}, "requiresReview": {"type": "boolean"}, "action": {"enum": ["NOTIFY", "DO_NOT_NOTIFY"]},
        "destinationIncidentType": {"$ref": "#/$defs/nullableText"}, "rawValue": {"type": ["string", "number", "boolean"]}
      },
      "if": {"properties": {"action": {"const": "DO_NOT_NOTIFY"}}},
      "then": {"properties": {"destinationIncidentType": {"type": "null"}}},
      "else": {"properties": {"destinationIncidentType": {"type": "string", "minLength": 1}}}
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["classifierCode", "codeComponents", "section", "statisticalGroup", "signIds", "additionalSignsText", "questionIds", "incidentType", "ekp35IncidentType", "responseScenarioCode", "responseScenarioStatus", "mainServiceIds", "routingRules", "source", "warnings"],
      "properties": {
        "classifierCode": {"type": "string", "pattern": "^[0-9]{7,8}$"},
        "codeComponents": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 999}},
        "section": {"$ref": "#/$defs/nullableText"}, "statisticalGroup": {"$ref": "#/$defs/nullableText"},
        "signIds": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/nullableText"}},
        "additionalSignsText": {"$ref": "#/$defs/nullableText"}, "questionIds": {"$ref": "#/$defs/strings"},
        "incidentType": {"type": "string", "minLength": 1}, "ekp35IncidentType": {"$ref": "#/$defs/nullableText"},
        "responseScenarioCode": {"$ref": "#/$defs/nullableText"},
        "responseScenarioStatus": {"enum": ["CODE", "MISSING", "EXPLICIT_NONE", "SOURCE_LABEL"]},
        "mainServiceIds": {"$ref": "#/$defs/strings"},
        "routingRules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "warnings": {"$ref": "#/$defs/strings"},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["sheet", "row", "rawFields"],
          "properties": {"sheet": {"type": "string"}, "row": {"type": "integer", "minimum": 4}, "rawFields": {"type": "array", "minItems": 9, "maxItems": 9}}
        }
      },
      "allOf": [
        {"if": {"properties": {"responseScenarioStatus": {"enum": ["MISSING", "EXPLICIT_NONE"]}}}, "then": {"properties": {"responseScenarioCode": {"type": "null"}}}},
        {"if": {"properties": {"responseScenarioStatus": {"const": "CODE"}}}, "then": {"properties": {"responseScenarioCode": {"type": "string", "pattern": "^[0-9]+_[0-9]+$"}}}},
        {"if": {"properties": {"responseScenarioStatus": {"const": "SOURCE_LABEL"}}}, "then": {"properties": {"responseScenarioCode": {"type": "string", "minLength": 1}}}}
      ]
    }
  }
}
