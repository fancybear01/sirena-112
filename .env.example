# The autonomous offline profile is intentionally restricted to this loopback address.
SIRENA_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=sirena112
POSTGRES_USER=sirena112
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
POSTGRES_PORT=5432

CORE_PORT=8080
CORE_ENVIRONMENT=offline
CORE_VERSION=2026.09.28
CORE_AUTH_ENABLED=false
CORE_BOOTSTRAP_ADMIN_USERNAME=admin
CORE_BOOTSTRAP_ADMIN_PASSWORD=GENERATE_ADMIN_PASSWORD
CORE_MEDIA_SERVICE_TOKEN=GENERATE_CORE_MEDIA_TOKEN
CORE_SCENARIO_IMPORT_ENABLED=false
CORE_SERVICE_ASSIGNMENT_DEADLINE_SECONDS=3600
CORE_SERVICE_ASSIGNMENT_MOCK_UPDATES_ENABLED=false

WEB_PORT=5173
VITE_AUTH_MODE=demo

AI_PORT=8090
AI_ENGINE=mock
AI_SERVICE_TOKEN=GENERATE_AI_SERVICE_TOKEN
AI_MODELS_DIR=./models
AI_STT=vosk
AI_TTS=piper
AI_REQUIRE_REAL_SPEECH=true

MEDIA_PORT=8091
MEDIA_MODE=ai
LOG_LEVEL=info

# Local Asterisk. Secrets are generated into ignored .env by stack init.
ASTERISK_SIP_PORT=5060
ASTERISK_HTTP_PORT=8088
ASTERISK_RTP_PORT_START=10000
ASTERISK_RTP_PORT_END=10100
ASTERISK_EXTERNAL_ADDRESS=127.0.0.1
ASTERISK_SIP_1001_PASSWORD=GENERATE_SIP_1001_PASSWORD
ASTERISK_SIP_1002_PASSWORD=GENERATE_SIP_1002_PASSWORD
ASTERISK_ARI_USER=media
ASTERISK_ARI_PASSWORD=GENERATE_ARI_PASSWORD

MONITOR_PORT=8099
