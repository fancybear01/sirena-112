POSTGRES_DB=sirena112
POSTGRES_USER=sirena112
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

CORE_PORT=8080
CORE_ENVIRONMENT=local
CORE_VERSION=dev
CORE_AI_BASE_URL=http://localhost:8090
CORE_MEDIA_BASE_URL=http://localhost:8091
CORE_SERVICE_ASSIGNMENT_DEADLINE_SECONDS=3600
# Only enable on an isolated training environment; no real DDS integration.
CORE_SERVICE_ASSIGNMENT_MOCK_UPDATES_ENABLED=false
WEB_PORT=3000
AI_PORT=8090
MEDIA_PORT=8091

JWT_SECRET=change-me-before-demo

# Local Asterisk (infra/asterisk, issue #9)
ASTERISK_SIP_PORT=5060
ASTERISK_HTTP_PORT=8088
ASTERISK_RTP_PORT_START=10000
ASTERISK_RTP_PORT_END=10100
ASTERISK_EXTERNAL_ADDRESS=127.0.0.1
ASTERISK_SIP_1001_PASSWORD=change-me-1001
ASTERISK_SIP_1002_PASSWORD=change-me-1002
ASTERISK_ARI_USER=media
ASTERISK_ARI_PASSWORD=change-me-ari

LOG_LEVEL=info
# Optional future Core ingest for media events (MVP logs events instead).
CORE_MEDIA_EVENTS_URL=

# Media voice bridge (echo stays independent of AI/Core).
MEDIA_MODE=echo
MEDIA_AI_BASE_URL=ws://host.docker.internal:8090
# In Compose set to http://core:8080 for correlated Core voice sessions.
MEDIA_CORE_BASE_URL=
# Enable only with CORE_AUTH_ENABLED=true and a shared CORE_MEDIA_SERVICE_TOKEN.
# Recording storage is a private Docker volume shared read-only with Core.
CORE_AUTH_ENABLED=false
CORE_MEDIA_SERVICE_TOKEN=
CORE_BOOTSTRAP_ADMIN_USERNAME=
CORE_BOOTSTRAP_ADMIN_PASSWORD=
MEDIA_RECORDINGS_DIR=
MEDIA_RECORDING_MAX_SECONDS=900
MEDIA_RECORDING_RETENTION_HOURS=168
